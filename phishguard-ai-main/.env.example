# Copy to .env in the project root. Replace the SECRET_KEY before starting.
APP_NAME=PhishGuard AI
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# or: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_EXPIRE_HOURS=24
EMAIL_VERIFICATION_REQUIRED=false

# Configure these together to send reset and verification emails. If verification is
# required, SMTP_HOST and SMTP_FROM_EMAIL are required at application startup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Local SQLite is the development default. Production requires PostgreSQL:
DATABASE_URL=sqlite+aiosqlite:///./phishguard.db
# Example: postgresql+asyncpg://phishguard:URL_ENCODED_PASSWORD@localhost:5432/phishguard
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Used by docker-compose.production.yml; provide unique non-default credentials.
POSTGRES_DB=phishguard
POSTGRES_USER=phishguard
POSTGRES_PASSWORD=
REDIS_PASSWORD=
HTTP_PORT=8080
# Use a random hexadecimal password (for example: python -c "import secrets; print(secrets.token_hex(32))")
# Production compose constructs REDIS_URL from REDIS_PASSWORD.
# Production DATABASE_URL must point to the Compose service and use a URL-encoded password:
# postgresql+asyncpg://phishguard:URL_ENCODED_PASSWORD@postgres:5432/phishguard

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Google credentials only indicate the Gmail OAuth scaffold is configured;
# Gmail OAuth is not yet implemented. Leave both blank unless testing that scaffold.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/email/oauth/callback

# Optional key for the standalone server-side reputation search helper.
# It is not currently invoked by the HTTP scanning endpoints.
ANTHROPIC_API_KEY=

# VirusTotal and Google Safe Browsing keys are not supported by this code yet.
# Do not add them here expecting live threat-intelligence lookups.

# Public frontend URL only; never put backend credentials in VITE_* variables.
VITE_API_BASE_URL=/api

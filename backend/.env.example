# Copy this file to .env and fill in real values before running in production
APP_NAME=PhishGuard AI
ENVIRONMENT=development

# Security - generate a real secret with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-64-character-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database - defaults to local SQLite file. Swap for Postgres in production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/phishguard
DATABASE_URL=sqlite+aiosqlite:///./phishguard.db

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: Gmail API integration (see backend/app/services/email_detection.py)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/email/oauth/callback

# Optional: external threat intel enrichment (VirusTotal, Google Safe Browsing, etc.)
VIRUSTOTAL_API_KEY=
SAFE_BROWSING_API_KEY=
